PORT=4173
NODE_ENV=development
APP_URL=http://localhost:4173
FORMSPEAR_DATA_FILE=./data/formspear.db.json
ENCRYPTION_KEY=replace-with-32-byte-secret
IP_HASH_SALT=replace-with-ip-hash-salt
WEBHOOK_SIGNING_SECRET=replace-with-webhook-signing-secret
PUBLIC_RATE_LIMIT_WINDOW_MS=60000
PUBLIC_RATE_LIMIT_MAX=120
DB_SAVE_BATCH_DELAY_MS=5
JOB_POLL_INTERVAL_MS=5000
CRON_SECRET=replace-with-cron-secret

# Production deployment placeholders from the PRD. The current local runtime does
# not require all of these yet, but keeping names stable prevents drift during
# the PostgreSQL/Redis/provider cutover.
DATABASE_URL=
POSTGRES_COMPATIBILITY_SNAPSHOT=false
PG_POOL_MAX=5
PGSSLMODE=
PGSSL_REJECT_UNAUTHORIZED=true
REDIS_URL=
BULLMQ_QUEUE_NAME=feedbackos-jobs
BULLMQ_WORKER_CONCURRENCY=4
JWT_SECRET=
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=notifications@example.com
SMTP_SECURE=true
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=
GOOGLE_OAUTH_AUTH_URL=https://accounts.google.com/o/oauth2/v2/auth
GOOGLE_OAUTH_TOKEN_URL=https://oauth2.googleapis.com/token
GOOGLE_OAUTH_USERINFO_URL=https://www.googleapis.com/oauth2/v3/userinfo
GOOGLE_OAUTH_SCOPE=openid email profile
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_ALLOWED_MODELS=gpt-4o-mini
OPENAI_TIMEOUT_MS=15000
AI_PROVIDER_DPA_ACCEPTED=false
AI_PROVIDER_DPA_URL=
AI_PROVIDER_DATA_RETENTION_DAYS=30
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_BASE_URL=https://api.stripe.com/v1
STRIPE_PORTAL_CONFIGURATION_ID=
STRIPE_AUTOMATIC_TAX=false
STRIPE_TAX_ID_COLLECTION=false
RAZORPAY_KEY_ID=
RAZORPAY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_BASE_URL=https://api.razorpay.com/v1
BILLING_TAX_MODE=exclusive
BILLING_TAX_PERCENT=18
BILLING_PRORATION_POLICY=create_prorations
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_PUBLIC_BASE_URL=
S3_LIFECYCLE_DAYS=365
