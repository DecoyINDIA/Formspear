PORT=4173
NODE_ENV=development
APP_URL=http://localhost:4173
FORMSPEAR_DATA_FILE=./data/formspear.db.json

# Core (required in production)
DATABASE_URL=
ENCRYPTION_KEY=replace-with-32-byte-secret
IP_HASH_SALT=replace-with-ip-hash-salt
WEBHOOK_SIGNING_SECRET=replace-with-webhook-signing-secret
CRON_SECRET=replace-with-cron-secret
# In production, the email address of the platform super admin. In development/local, the first user created becomes super admin.
SUPER_ADMIN_EMAIL=
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=notifications@example.com
SMTP_SECURE=true

# Server and security operational defaults
# Feature flags for optional/parked route groups: sso, apiV1, campaigns, agency, inAppSdk.
# In development, defaults to all features. In production, defaults to none unless explicitly set (e.g. 'all', 'none', or comma-separated list).
FORMSPEAR_FEATURES=
PUBLIC_RATE_LIMIT_WINDOW_MS=60000
PUBLIC_RATE_LIMIT_MAX=120
# Number of reverse proxies in front of the app. 0 = use the socket address. Set to 1 on a single-proxy host. Setting it too high lets clients spoof their IP.
TRUST_PROXY_HOPS=0
DB_SAVE_BATCH_DELAY_MS=5
JOB_POLL_INTERVAL_MS=5000
BOOTSTRAP_ADMIN_EMAIL=
ALLOW_MANUAL_PLAN_CHANGES=false
POSTGRES_COMPATIBILITY_SNAPSHOT=false
# Maximum number of audit, error, and AI provider logs retained in memory before older rows are trimmed from memory (remains in Postgres).
LOG_MEMORY_MAX=5000
PG_POOL_MAX=5
PGSSLMODE=
PGSSL_REJECT_UNAUTHORIZED=true
# Optional queue transport. Formspear runs a single web process that handles HTTP and jobs; Redis is optional and only changes the in-process queue transport.
REDIS_URL=
BULLMQ_QUEUE_NAME=feedbackos-jobs
BULLMQ_WORKER_CONCURRENCY=4
JWT_SECRET=

# Optional features: Uploads (S3/R2 storage + file scanning)
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_PUBLIC_BASE_URL=
S3_LIFECYCLE_DAYS=365
FILE_SCAN_MODE=local
FILE_SCAN_PROVIDER_URL=
FILE_SCAN_PROVIDER_TOKEN=
FILE_SCAN_TIMEOUT_MS=5000
FILE_SCAN_FAIL_OPEN=false
FILE_SCAN_BLOCKED_EXTENSIONS=exe,com,scr,bat,cmd,ps1,sh,vbs,js,jar,msi,dll

# Optional features: AI (OpenAI-compatible summary, classification, and drafting)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_ALLOWED_MODELS=gpt-4o-mini
OPENAI_TIMEOUT_MS=15000
AI_PROVIDER_DPA_ACCEPTED=false
AI_PROVIDER_DPA_URL=
AI_PROVIDER_DATA_RETENTION_DAYS=30

# Optional features: Stripe billing
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_BASE_URL=https://api.stripe.com/v1
STRIPE_PORTAL_CONFIGURATION_ID=
STRIPE_AUTOMATIC_TAX=false
STRIPE_TAX_ID_COLLECTION=false
BILLING_TAX_MODE=exclusive
BILLING_TAX_PERCENT=18
BILLING_PRORATION_POLICY=create_prorations

# Optional features: Razorpay billing
RAZORPAY_KEY_ID=
RAZORPAY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_BASE_URL=https://api.razorpay.com/v1

# Optional features: Google OAuth
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=
GOOGLE_OAUTH_AUTH_URL=https://accounts.google.com/o/oauth2/v2/auth
GOOGLE_OAUTH_TOKEN_URL=https://oauth2.googleapis.com/token
GOOGLE_OAUTH_USERINFO_URL=https://www.googleapis.com/oauth2/v3/userinfo
GOOGLE_OAUTH_SCOPE=openid email profile

# Optional features: Custom domain SSL
CUSTOM_DOMAIN_SSL_PROVIDER_URL=
CUSTOM_DOMAIN_SSL_PROVIDER_TOKEN=
CUSTOM_DOMAIN_SSL_PROVIDER_NAME=cloudflare
CUSTOM_DOMAIN_SSL_TIMEOUT_MS=10000

# Optional features: Webhooks and external integrations
INTEGRATION_TIMEOUT_MS=8000
GOOGLE_SHEETS_WEBHOOK_URL=
GOOGLE_SHEETS_TOKEN=
GOOGLE_SHEETS_API_KEY=
SLACK_WEBHOOK_URL=
SLACK_TOKEN=
TEAMS_WEBHOOK_URL=
TEAMS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_TO=
CRM_WEBHOOK_URL=
CRM_TOKEN=
ZAPIER_WEBHOOK_URL=
MAKE_WEBHOOK_URL=

# Optional telemetry and monitoring (recommended, not enforced for boot)
SENTRY_DSN=
POSTHOG_KEY=
POSTHOG_HOST=https://app.posthog.com
MONITORING_TIMEOUT_MS=5000
UPTIME_CHECK_PROVIDER=uptime-kuma
UPTIME_CHECK_URL=
MONITORING_ALERT_WEBHOOK_URL=
